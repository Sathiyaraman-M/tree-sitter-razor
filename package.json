{
  "name": "tree-sitter-razor",
  "version": "0.1.0",
  "description": "Razor Grammar, particularly tuned towards Blazor flavour of Razor",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sathiyaraman-m/tree-sitter-razor.git"
  },
  "license": "MIT",
  "author": {
    "name": "Sathiyaraman-M",
    "email": "Sathiyaraman2003@gmail.com",
    "url": "https://www.sathiyaraman-m.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "razor"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4",
    "tree-sitter-c-sharp": "^0.23.5"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.3"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
