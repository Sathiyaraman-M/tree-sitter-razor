{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "razor",
      "camelcase": "Razor",
      "title": "Razor",
      "scope": "source.razor",
      "file-types": [
        "razor"
      ],
      "injection-regex": "^razor$",
      "class-name": "TreeSitterRazor"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Razor Grammar, particularly tuned towards Blazor flavour of Razor",
    "authors": [
      {
        "name": "Sathiyaraman-M",
        "email": "Sathiyaraman2003@gmail.com",
        "url": "https://www.sathiyaraman-m.com"
      }
    ],
    "links": {
      "repository": "https://github.com/Sathiyaraman-M/tree-sitter-razor"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}